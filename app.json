{
  "expo": {
    "name": "SSHBond",
    "slug": "sshbond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sshbond.client",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SSHBond uses Face ID to securely authenticate and protect your private SSH keys."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.sshbond.client",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "./modules/expo-sshbond/app.plugin.js"
    ],
    "scheme": "sshbond",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb9d1d96-2bb9-4291-936d-6c75bd7f6ea6"
      }
    },
    "owner": "paugnu"
  }
}
