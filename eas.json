{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "testing": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "SSHBOND_HANDSHAKE_PROBE": "1"
      },
      "buildArtifactPaths": [
        "output/release-evidence/**"
      ]
    },
    "handshake-probe": {
      "extends": "development-simulator",
      "env": {
        "SSHBOND_HANDSHAKE_PROBE": "1"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "store-screenshots": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "SSHBOND_STORE_SCREENSHOTS": "1"
      },
      "buildArtifactPaths": [
        "output/release-evidence/**"
      ]
    }
  },
  "submit": {
    "production": {},
    "testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleTeamId": "W543Q9Q8K5",
        "ascAppId": "6809179913",
        "groups": [
          "Pruebas internas"
        ]
      }
    }
  }
}
