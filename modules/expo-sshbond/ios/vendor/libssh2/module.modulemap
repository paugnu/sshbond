// Makes libssh2 importable from Swift as `Libssh2`.
//
// A C library living inside the same pod as the Swift that calls it is not
// visible to it otherwise: pods have no bridging header, and the pod's own
// umbrella module cannot import itself. The podspec points
// SWIFT_INCLUDE_PATHS at this directory.
module Libssh2 {
  header "include/libssh2.h"
  header "include/libssh2_publickey.h"
  header "include/libssh2_sftp.h"
  export *
}
